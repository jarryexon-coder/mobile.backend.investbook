{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "buildNumber": "1.0.13"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildNumber": "1.0.13"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://investbook-production.up.railway.app/api",
        "EXPO_PUBLIC_RAPIDAPI_KEY": "$EXPO_PUBLIC_RAPIDAPI_KEY",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "$EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": false,
      "ios": {
        "buildNumber": "1.0.13"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://investbook-production.up.railway.app/api",
        "EXPO_PUBLIC_RAPIDAPI_KEY": "$EXPO_PUBLIC_RAPIDAPI_KEY",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "$EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
